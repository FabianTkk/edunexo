# Copiar este archivo como .env (en la raiz del proyecto) y completar los valores.
# .env NO se sube a GitHub (esta en .gitignore).

# URL donde corre Evolution API
EVOLUTION_API_URL=http://localhost:8080

# Nombre de la instancia de WhatsApp en Evolution API
EVOLUTION_INSTANCE=edunexo

# Debe ser igual a AUTHENTICATION_API_KEY del .env de evolution-api.
# Generar una larga y aleatoria, por ejemplo con:  php -r "echo bin2hex(random_bytes(24));"
EVOLUTION_API_KEY=
